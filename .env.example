# Copy to .env and fill in only what you need. Every value here is a placeholder.
# With nothing set, QuantumAgent runs fully locally (NumPy state-vector simulator).

# --- LLM (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Literature search ---
# Set to 1 to skip arXiv/PubMed network calls and search only the local library.
QUANTUMAGENT_OFFLINE=
PUBMED_EMAIL=
SEMANTIC_SCHOLAR_KEY=

# --- Cloud quantum backends (optional, may be billed by the provider) ---
# Nothing is sent to a cloud provider unless this is true AND the provider's credential is set.
QUANTUMAGENT_ENABLE_CLOUD=false

# IBM Quantum (working adapter; needs: pip install qiskit-ibm-runtime)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CHANNEL=
IBM_QUANTUM_INSTANCE=

# Listed for future adapters (not implemented yet)
IONQ_API_KEY=
QUANTINUUM_API_KEY=
RIGETTI_API_KEY=
AWS_ACCESS_KEY_ID=
AZURE_QUANTUM_RESOURCE_ID=
