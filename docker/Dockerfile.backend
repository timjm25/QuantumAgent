FROM python:3.11-slim

LABEL maintainer="QuantumAgent <tim.maguire25@gmail.com>"
LABEL description="QuantumAgent backend — multi-agent AI platform for quantum research"

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Application code
COPY backend/ ./backend/
COPY tests/ ./tests/
COPY scripts/ ./scripts/

# Non-root user
RUN useradd -m -u 1000 quantumagent && chown -R quantumagent /app
USER quantumagent

# Directories
RUN mkdir -p data checkpoints

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
